{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0xdolan.github.io/unichef/schema/errors-v1.json",
  "title": "UniChef error and warning catalogue",
  "type": "object",
  "required": ["version", "errors", "warnings"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "exit", "meaning"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "pattern": "^E_[A-Z][A-Z0-9_]*$" },
          "exit": { "type": "integer", "minimum": 1, "maximum": 255 },
          "meaning": { "type": "string", "minLength": 1 }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "meaning"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "pattern": "^W_[A-Z][A-Z0-9_]*$" },
          "meaning": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
