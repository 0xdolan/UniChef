{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0xdolan.github.io/unichef/schema/recipe-v1.json",
  "title": "UniChef Recipe v1",
  "type": "object",
  "required": ["version", "steps"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "maxLength": 200 },
    "description": { "type": "string", "maxLength": 5000 },
    "seed": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "steps": { "$ref": "#/$defs/steps" }
  },
  "$defs": {
    "steps": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/step" } },
    "step": {
      "type": "object",
      "required": ["op"],
      "additionalProperties": false,
      "properties": {
        "op": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "args": { "type": "object" },
        "disabled": { "type": "boolean", "default": false },
        "breakpoint": { "type": "boolean", "default": false },
        "label": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
        "comment": { "type": "string", "maxLength": 2000 }
      }
    }
  }
}
