{
  "op": "from-braille",
  "cases": [
    {
      "name": "default",
      "args": {},
      "input": {
        "type": "string",
        "text": "⠓⠊⠮"
      },
      "expected": {
        "type": "string",
        "text": "HI!"
      }
    },
    {
      "name": "empty",
      "args": {},
      "input": {
        "type": "string",
        "text": ""
      },
      "expected": {
        "type": "string",
        "text": ""
      }
    },
    {
      "name": "all 64 patterns",
      "args": {},
      "input": {
        "type": "string",
        "text": "⠀⠁⠂⠃⠄⠅⠆⠇⠈⠉⠊⠋⠌⠍⠎⠏⠐⠑⠒⠓⠔⠕⠖⠗⠘⠙⠚⠛⠜⠝⠞⠟⠠⠡⠢⠣⠤⠥⠦⠧⠨⠩⠪⠫⠬⠭⠮⠯⠰⠱⠲⠳⠴⠵⠶⠷⠸⠹⠺⠻⠼⠽⠾⠿"
      },
      "expected": {
        "type": "string",
        "text": " A1B'K2L@CIF/MSP\"E3H9O6R^DJG>NTQ,*5<-U8V.%[$+X!&;:4\\0Z7(_?W]#Y)="
      }
    },
    {
      "name": "eight-dot patterns and others are copied",
      "args": {},
      "input": {
        "type": "string",
        "text": "⡀⣿ a"
      },
      "expected": {
        "type": "string",
        "text": "⡀⣿ a"
      }
    },
    {
      "name": "blank pattern is a space",
      "args": {},
      "input": {
        "type": "string",
        "text": "⠀"
      },
      "expected": {
        "type": "string",
        "text": " "
      }
    },
    {
      "name": "letters come out in upper case",
      "args": {},
      "input": {
        "type": "string",
        "text": "⠁⠃"
      },
      "expected": {
        "type": "string",
        "text": "AB"
      }
    },
    {
      "name": "a sentence",
      "args": {},
      "input": {
        "type": "string",
        "text": "⠓⠑⠇⠇⠕⠀⠺⠕⠗⠇⠙"
      },
      "expected": {
        "type": "string",
        "text": "HELLO WORLD"
      }
    },
    {
      "name": "lines are kept",
      "args": {},
      "input": {
        "type": "string",
        "text": "⠁\n⠃"
      },
      "expected": {
        "type": "string",
        "text": "A\nB"
      }
    },
    {
      "name": "error: an unknown argument",
      "args": {
        "bogus": 1
      },
      "input": {
        "type": "string",
        "text": "a"
      },
      "expected": {
        "error": "E_ARG_INVALID"
      }
    }
  ]
}
