{
  "op": "text-integer",
  "cases": [
    {
      "name": "default: text to decimal",
      "args": {
        "output": "decimal"
      },
      "input": {
        "type": "string",
        "text": "ABC"
      },
      "expected": {
        "type": "string",
        "text": "4276803"
      }
    },
    {
      "name": "empty is zero",
      "args": {
        "output": "decimal"
      },
      "input": {
        "type": "string",
        "text": ""
      },
      "expected": {
        "type": "string",
        "text": "0"
      }
    },
    {
      "name": "CyberChef: quoted string to decimal",
      "args": {
        "output": "decimal"
      },
      "input": {
        "type": "string",
        "text": "\"ABC\""
      },
      "expected": {
        "type": "string",
        "text": "4276803"
      }
    },
    {
      "name": "CyberChef: quoted string to hex",
      "args": {
        "output": "hex"
      },
      "input": {
        "type": "string",
        "text": "\"ABC\""
      },
      "expected": {
        "type": "string",
        "text": "0x414243"
      }
    },
    {
      "name": "CyberChef: single quoted to decimal",
      "args": {
        "output": "decimal"
      },
      "input": {
        "type": "string",
        "text": "'Hello'"
      },
      "expected": {
        "type": "string",
        "text": "310939249775"
      }
    },
    {
      "name": "CyberChef: decimal to string",
      "args": {},
      "input": {
        "type": "string",
        "text": "4276803"
      },
      "expected": {
        "type": "string",
        "text": "ABC"
      }
    },
    {
      "name": "CyberChef: hex to string",
      "args": {},
      "input": {
        "type": "string",
        "text": "0x48656C6C6F"
      },
      "expected": {
        "type": "string",
        "text": "Hello"
      }
    },
    {
      "name": "decimal to hex",
      "args": {
        "output": "hex"
      },
      "input": {
        "type": "string",
        "text": "255"
      },
      "expected": {
        "type": "string",
        "text": "0xff"
      }
    },
    {
      "name": "hex to decimal, upper-case prefix",
      "args": {
        "output": "decimal"
      },
      "input": {
        "type": "string",
        "text": "0XfF"
      },
      "expected": {
        "type": "string",
        "text": "255"
      }
    },
    {
      "name": "negative decimal",
      "args": {
        "output": "decimal"
      },
      "input": {
        "type": "string",
        "text": "-5"
      },
      "expected": {
        "type": "string",
        "text": "-5"
      }
    },
    {
      "name": "negative to hex",
      "args": {
        "output": "hex"
      },
      "input": {
        "type": "string",
        "text": "-255"
      },
      "expected": {
        "type": "string",
        "text": "-0xff"
      }
    },
    {
      "name": "zero to string is empty",
      "args": {},
      "input": {
        "type": "string",
        "text": "0"
      },
      "expected": {
        "type": "string",
        "text": ""
      }
    },
    {
      "name": "zero to hex",
      "args": {
        "output": "hex"
      },
      "input": {
        "type": "string",
        "text": "0"
      },
      "expected": {
        "type": "string",
        "text": "0x0"
      }
    },
    {
      "name": "quoted digits are text",
      "args": {
        "output": "decimal"
      },
      "input": {
        "type": "string",
        "text": "'12'"
      },
      "expected": {
        "type": "string",
        "text": "12594"
      }
    },
    {
      "name": "Latin-1 text",
      "args": {
        "output": "hex"
      },
      "input": {
        "type": "string",
        "text": "é ÿ"
      },
      "expected": {
        "type": "string",
        "text": "0xe920ff"
      }
    },
    {
      "name": "white space is trimmed, inner kept",
      "args": {
        "output": "hex"
      },
      "input": {
        "type": "string",
        "text": "  a b\n"
      },
      "expected": {
        "type": "string",
        "text": "0x612062"
      }
    },
    {
      "name": "mismatched quotes are both removed",
      "args": {
        "output": "hex"
      },
      "input": {
        "type": "string",
        "text": "\"a'"
      },
      "expected": {
        "type": "string",
        "text": "0x61"
      }
    },
    {
      "name": "a quoted line break keeps the quotes",
      "args": {
        "output": "hex"
      },
      "input": {
        "type": "string",
        "text": "'a\nb'"
      },
      "expected": {
        "type": "string",
        "text": "0x27610a6227"
      }
    },
    {
      "name": "leading zero bytes are lost",
      "args": {
        "output": "hex"
      },
      "input": {
        "type": "string",
        "text": "\u0000\u0000A"
      },
      "expected": {
        "type": "string",
        "text": "0x41"
      }
    },
    {
      "name": "1024 bytes",
      "args": {
        "output": "decimal"
      },
      "input": {
        "type": "string",
        "text": ""
      },
      "expected": {
        "type": "string",
        "text": ""
      }
    },
    {
      "name": "error: character above U+00FF",
      "args": {},
      "input": {
        "type": "string",
        "text": "日本"
      },
      "expected": {
        "error": "E_DECODE"
      }
    },
    {
      "name": "error: negative to string",
      "args": {},
      "input": {
        "type": "string",
        "text": "-65"
      },
      "expected": {
        "error": "E_DECODE"
      }
    },
    {
      "name": "error: 1025 bytes",
      "args": {
        "output": "decimal"
      },
      "input": {
        "type": "string",
        "text": ""
      },
      "expected": {
        "error": "E_DECODE"
      }
    },
    {
      "name": "error: 1025 characters",
      "args": {
        "output": "hex"
      },
      "input": {
        "type": "string",
        "text": ""
      },
      "expected": {
        "error": "E_DECODE"
      }
    }
  ]
}
