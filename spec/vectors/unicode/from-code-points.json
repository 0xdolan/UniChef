{
  "op": "from-code-points",
  "cases": [
    {
      "name": "empty input",
      "args": {},
      "input": {
        "type": "string",
        "text": ""
      },
      "expected": {
        "type": "codepoints",
        "values": []
      }
    },
    {
      "name": "mixed notations",
      "args": {},
      "input": {
        "type": "string",
        "text": "U+0041 e9, 0x1F600;42"
      },
      "expected": {
        "type": "codepoints",
        "values": [
          65,
          233,
          128512,
          66
        ]
      }
    },
    {
      "name": "lower-case u+",
      "args": {},
      "input": {
        "type": "string",
        "text": "u+00e9"
      },
      "expected": {
        "type": "codepoints",
        "values": [
          233
        ]
      }
    },
    {
      "name": "decimal",
      "args": {
        "base": "decimal"
      },
      "input": {
        "type": "string",
        "text": "65 233 128512"
      },
      "expected": {
        "type": "codepoints",
        "values": [
          65,
          233,
          128512
        ]
      }
    },
    {
      "name": "prefix forces hex",
      "args": {
        "base": "decimal"
      },
      "input": {
        "type": "string",
        "text": "U+41 0x41 41"
      },
      "expected": {
        "type": "codepoints",
        "values": [
          65,
          65,
          41
        ]
      }
    },
    {
      "name": "surrogates are kept",
      "args": {},
      "input": {
        "type": "string",
        "text": "D83D DE00"
      },
      "expected": {
        "type": "codepoints",
        "values": [
          55357,
          56832
        ]
      }
    },
    {
      "name": "extra separators",
      "args": {},
      "input": {
        "type": "string",
        "text": " ,41;; 42\n"
      },
      "expected": {
        "type": "codepoints",
        "values": [
          65,
          66
        ]
      }
    },
    {
      "name": "above 10FFFF",
      "args": {},
      "input": {
        "type": "string",
        "text": "110000"
      },
      "expected": {
        "error": "E_DECODE"
      }
    },
    {
      "name": "not a number",
      "args": {},
      "input": {
        "type": "string",
        "text": "xyz"
      },
      "expected": {
        "error": "E_DECODE"
      }
    },
    {
      "name": "hex digits in decimal mode",
      "args": {
        "base": "decimal"
      },
      "input": {
        "type": "string",
        "text": "1F"
      },
      "expected": {
        "error": "E_DECODE"
      }
    }
  ]
}
