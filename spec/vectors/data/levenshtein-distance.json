{
  "op": "levenshtein-distance",
  "cases": [
    {
      "name": "default",
      "args": {},
      "input": {
        "type": "string",
        "text": "kitten\nsitting"
      },
      "expected": {
        "type": "string",
        "text": "3"
      }
    },
    {
      "name": "empty",
      "args": {},
      "input": {
        "type": "string",
        "text": ""
      },
      "expected": {
        "type": "string",
        "text": ""
      }
    },
    {
      "name": "both samples empty",
      "args": {},
      "input": {
        "type": "string",
        "text": "\n"
      },
      "expected": {
        "type": "string",
        "text": "0"
      }
    },
    {
      "name": "one sample empty",
      "args": {},
      "input": {
        "type": "string",
        "text": "abc\n"
      },
      "expected": {
        "type": "string",
        "text": "3"
      }
    },
    {
      "name": "identical",
      "args": {},
      "input": {
        "type": "string",
        "text": "same\nsame"
      },
      "expected": {
        "type": "string",
        "text": "0"
      }
    },
    {
      "name": "weighted substitution",
      "args": {
        "substitution": 3
      },
      "input": {
        "type": "string",
        "text": "kitten\nsitting"
      },
      "expected": {
        "type": "string",
        "text": "5"
      }
    },
    {
      "name": "free insertion",
      "args": {
        "insertion": 0
      },
      "input": {
        "type": "string",
        "text": "ab\nxaby"
      },
      "expected": {
        "type": "string",
        "text": "0"
      }
    },
    {
      "name": "code points, not UTF-16 units",
      "args": {},
      "input": {
        "type": "string",
        "text": "a😀\na😃"
      },
      "expected": {
        "type": "string",
        "text": "1"
      }
    },
    {
      "name": "custom delimiter",
      "args": {
        "delimiter": " vs "
      },
      "input": {
        "type": "string",
        "text": "flaw vs lawn"
      },
      "expected": {
        "type": "string",
        "text": "2"
      }
    },
    {
      "name": "error: one sample",
      "args": {},
      "input": {
        "type": "string",
        "text": "kitten"
      },
      "expected": {
        "error": "E_DECODE"
      }
    },
    {
      "name": "error: three samples",
      "args": {},
      "input": {
        "type": "string",
        "text": "a\nb\nc"
      },
      "expected": {
        "error": "E_DECODE"
      }
    },
    {
      "name": "error: negative cost",
      "args": {
        "deletion": -1
      },
      "input": {
        "type": "string",
        "text": "a\nb"
      },
      "expected": {
        "error": "E_ARG_INVALID"
      }
    },
    {
      "name": "error: too long",
      "args": {},
      "input": {
        "type": "string",
        "text": "\"
      },
      "expected": {
        "error": "E_LIMIT"
      }
    }
  ]
}
