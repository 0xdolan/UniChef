  "cases": [
    { "name": "bytes stay bytes", "input": { "type": "bytes", "hex": "00ff" }, "expected": { "type": "bytes", "hex": "00ff" } },
    { "name": "string stays string", "input": { "type": "string", "text": "😀" }, "expected": { "type": "string", "text": "😀" } }
  ]
