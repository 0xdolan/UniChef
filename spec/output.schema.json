{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0xdolan.github.io/unichef/schema/output-v1.json",
  "title": "UniChef CLI JSON output envelope v1",
  "description": "Shape of every --json result printed by the CLI (PRD §5.6).",
  "type": "object",
  "required": ["unichef", "ucd", "command", "ok", "result", "warnings", "error", "timing_ms"],
  "additionalProperties": false,
  "properties": {
    "unichef": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
    "ucd": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "command": { "type": "string", "minLength": 1 },
    "ok": { "type": "boolean" },
    "result": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/dish" }] },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } },
    "error": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/error" }] },
    "timing_ms": { "type": "integer", "minimum": 0 }
  },
  "if": { "properties": { "ok": { "const": true } } },
  "then": { "properties": { "error": { "type": "null" } } },
  "else": { "properties": { "result": { "type": "null" }, "error": { "type": "object" } } },
  "$defs": {
    "bigint": {
      "description": "Integers up to 2^53-1 in magnitude are numbers; larger ones are decimal strings.",
      "oneOf": [
        { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
        { "type": "string", "pattern": "^-?[0-9]+$" }
      ]
    },
    "dish": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "base64"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "bytes" },
            "base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$" }
          }
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": false,
          "properties": { "type": { "const": "string" }, "value": { "type": "string" } }
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": false,
          "properties": { "type": { "const": "integer" }, "value": { "$ref": "#/$defs/bigint" } }
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": false,
          "properties": { "type": { "const": "float" }, "value": { "type": ["number", "string"] } }
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": false,
          "properties": { "type": { "const": "json" }, "value": true }
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "codepoints" },
            "value": {
              "type": "array",
              "items": { "type": "integer", "minimum": 0, "maximum": 1114111 }
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "table" },
            "value": {
              "type": "object",
              "required": ["columns", "rows"],
              "additionalProperties": false,
              "properties": {
                "columns": { "type": "array", "items": { "type": "string" } },
                "rows": { "type": "array", "items": { "type": "array" } }
              }
            }
          }
        }
      ]
    },
    "warning": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^W_[A-Z][A-Z0-9_]*$" },
        "message": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^E_[A-Z][A-Z0-9_]*$" },
        "message": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "detail": { "type": "object" }
      }
    }
  }
}
