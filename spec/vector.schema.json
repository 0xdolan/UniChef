{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UniChef shared test vector file v1",
  "description": "Op vectors (spec/vectors/<category>/<op>.json) or recipe vectors (spec/vectors/_recipes/*.json), run by both cores (PRD §3.9).",
  "oneOf": [
    {
      "type": "object",
      "required": ["op", "cases"],
      "additionalProperties": false,
      "properties": {
        "op": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/opCase" } }
      }
    },
    {
      "type": "object",
      "required": ["recipe", "cases"],
      "additionalProperties": false,
      "properties": {
        "recipe": { "$ref": "recipe.schema.json" },
        "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/recipeCase" } }
      }
    }
  ],
  "$defs": {
    "opCase": {
      "type": "object",
      "required": ["name", "args", "input", "expected"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "args": { "type": "object" },
        "input": { "$ref": "#/$defs/dish" },
        "expected": { "$ref": "#/$defs/outcome" },
        "warnings": { "$ref": "#/$defs/warnings" }
      }
    },
    "recipeCase": {
      "type": "object",
      "required": ["name", "input", "expected"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "input": { "$ref": "#/$defs/dish" },
        "expected": { "$ref": "#/$defs/outcome" },
        "warnings": { "$ref": "#/$defs/warnings" }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "pattern": "^W_[A-Z][A-Z0-9_]*$" }
    },
    "outcome": {
      "oneOf": [
        { "$ref": "#/$defs/dish" },
        {
          "type": "object",
          "required": ["error"],
          "additionalProperties": false,
          "properties": { "error": { "type": "string", "pattern": "^E_[A-Z][A-Z0-9_]*$" } }
        }
      ]
    },
    "dish": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "hex"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "bytes" },
            "hex": { "type": "string", "pattern": "^([0-9a-f]{2})*$" }
          }
        },
        {
          "type": "object",
          "required": ["type", "text"],
          "additionalProperties": false,
          "properties": { "type": { "const": "string" }, "text": { "type": "string" } }
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "integer" },
            "value": {
              "oneOf": [
                { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
                { "type": "string", "pattern": "^-?[0-9]+$" }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": false,
          "properties": { "type": { "const": "float" }, "value": { "type": ["number", "string"] } }
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": false,
          "properties": { "type": { "const": "json" }, "value": true }
        },
        {
          "type": "object",
          "required": ["type", "values"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "codepoints" },
            "values": {
              "type": "array",
              "items": { "type": "integer", "minimum": 0, "maximum": 1114111 }
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "table" },
            "value": {
              "type": "object",
              "required": ["columns", "rows"],
              "additionalProperties": false,
              "properties": {
                "columns": { "type": "array", "items": { "type": "string" } },
                "rows": { "type": "array", "items": { "type": "array" } }
              }
            }
          }
        }
      ]
    }
  }
}
