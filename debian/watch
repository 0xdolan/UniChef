version=4
# The release tarball is the orig built by scripts/deb/make-orig.sh. Pre-release tags
# (v0.1.0-alpha.1) map to Debian's ~ form (0.1.0~alpha1).
opts="uversionmangle=s/-(alpha|beta|rc)\./~$1/" \
  https://github.com/0xdolan/unichef/releases/expanded_assets/v@ANY_VERSION@ \
  .*/unichef-v?(\d[\d.]*(?:-(?:alpha|beta|rc)\.\d+)?)\.tar\.gz
